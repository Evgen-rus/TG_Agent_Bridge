TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=xhigh
SEPIA_ENABLED=true
OWNER_CODEX_MODEL=gpt-6-luna
OWNER_CODEX_REASONING_EFFORT=xhigh
# Экспериментальная рабочая память только для OWNER; выключить: false.
OWNER_WORKING_MEMORY_ENABLED=true
# Локальная зона для фраз «сегодня», «за неделю» и подобных owner-запросов.
OWNER_TIMEZONE=Asia/Novosibirsk
# Зона, в которой Codex печатает время сброса лимита. В тексте ошибки Codex
# зоны нет («try again at 11:27 AM»), поэтому пересчёт опирается на это
# значение и подписывается как предположение. Должна совпадать с часовым
# поясом сервера: /etc/timezone.
CODEX_SESSION_TIMEZONE=Europe/Moscow
MESSAGE_BATCH_SECONDS=20
DELIVERY_RETRY_SECONDS=30
CATCHUP_IDLE_SECONDS=2
CATCHUP_EPISODE_SIZE=40
TELEGRAM_BOOTSTRAP_RETRIES=5
TELEGRAM_POLL_HARD_TIMEOUT_SECONDS=30
TELEGRAM_POLL_WATCHDOG_SECONDS=15
TELEGRAM_POLL_STALL_SECONDS=90
TELEGRAM_POLL_RESTART_TIMEOUT_SECONDS=30
MEDIA_DIR=runtime/media
MEDIA_TTL_SECONDS=3600
LOG_DIR=runtime/logs
LOG_RETENTION_DAYS=7
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=07:30
DAILY_REPORT_TIMEZONE=Europe/Moscow

# Настройки обработки голосовых сообщений
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Нужен для распознавания голосовых и генерации изображений по запросу владельца.
# Запросы к Images API тарифицируются отдельно; Codex работает по подписке ChatGPT.
OPENAI_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_QUALITY=low

# Голосовые ответы владельцу. Сейчас доступен OpenRouter; модуль выбирает
# провайдера из списка только если он зарегистрирован и укладывается в лимит.
# Нулевой лимит разрешает только модели с подтверждённой нулевой ценой.
# Если зададите ненулевой предел, можно будет выбирать оценённые платные маршруты.
OWNER_VOICE_ENABLED=true
OWNER_VOICE_PROVIDER_ORDER=openrouter
OWNER_VOICE_MAX_COST_USD=0
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# У каждого TTS-моделя свой voice ID; это пример для Fish Audio S2.1 Pro Free.
OPENROUTER_TTS_VOICE=cb92b10e1a5946b9b6bd7391aefe31fe
# d8d98452df6440e082ea2f6179fa197f — тоже Рик Санчез, русский, но более глубокий, властный и драматичный
# 5b5ec1f32af44ee08729a3cd004eee1f — просто нормальный русский мужской голос среднего возраста, если захочется меньше мультяшности
OPENROUTER_TTS_TIMEOUT_SECONDS=120

# Optional LeadRecord SSH adapter (dedicated restricted key)
LEADRECORD_SSH_TARGET=
LEADRECORD_SSH_IDENTITY=
