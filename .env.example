TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=xhigh
SEPIA_ENABLED=true
OWNER_CODEX_MODEL=gpt-6-luna
OWNER_CODEX_REASONING_EFFORT=xhigh
SEPIA_ENABLED=true
# Локальная зона для фраз «сегодня», «за неделю» и подобных owner-запросов.
OWNER_TIMEZONE=Asia/Novosibirsk
# Зона, в которой Codex печатает время сброса лимита в тексте ошибки.
# Должна совпадать с часовым поясом сервера: /etc/timezone.
CODEX_SESSION_TIMEZONE=Europe/Moscow
MESSAGE_BATCH_SECONDS=20
DELIVERY_RETRY_SECONDS=30
CATCHUP_IDLE_SECONDS=2
CATCHUP_EPISODE_SIZE=40
TELEGRAM_BOOTSTRAP_RETRIES=5
TELEGRAM_POLL_HARD_TIMEOUT_SECONDS=30
TELEGRAM_POLL_WATCHDOG_SECONDS=15
TELEGRAM_POLL_STALL_SECONDS=90
TELEGRAM_POLL_RESTART_TIMEOUT_SECONDS=30
MEDIA_DIR=runtime/media
MEDIA_TTL_SECONDS=3600
LOG_DIR=runtime/logs
LOG_RETENTION_DAYS=7
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=07:30
DAILY_REPORT_TIMEZONE=Europe/Moscow

# Настройки обработки голосовых сообщений
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OpenAI
OPENAI_API_KEY=
